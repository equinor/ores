      "data": {
        "Name": "GRAND — Decision Gate 2 DG2 Concept Select",
        "Description": "DG2 concept selection for the Grane Northern Area Development (GRAND) project. The GRAND area comprises F-Structure and D-Structure discoveries in Palaeocene Heimdal Formation sands on the NW flank of Utsira High, Viking Graben. 300 geo-realisations were run to quantify STOIIP uncertainty across three structures (F, D, D-North) and three facies groups (Heimdal, Mapped Injectites, Unmapped Injectites). DG2 recommends subsea tie-back to Grane with 4×6-slot templates, 23 wells (including 2 multilateral), targeting June 2023 start-up.",
        "ProjectName": "Grane Northern Area Development (GRAND)",
        "DecisionLevelID": "dev:reference-data--DecisionLevel:DG2:1",
        "ApprovalStatusID": "dev:reference-data--DecisionApprovalStatus:Approved:1",
        "DecisionDueDate": "2019-04-26",
        "DecisionDate": "2019-04-26",
        "DecisionSummary": "Approve subsea tie-back development to Grane platform. Four 6-slot templates (24 slots), 23 wells plus 2 multilateral. Reference case STOIIP 118.7 MSm³ (P90 70.7, P10 158.7). Start-up target June 2023.",
        "RiskAssessmentDocument": "dev:work-product-component--Document:PM398-DD-200-001_01_Final_INTERNAL.pdf:1",
        "RiskIDs": [
          "dev:master-data--Risk:GRAND-DepthConversionTopReservoir:1",
