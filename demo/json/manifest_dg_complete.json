            "Alternatives": [
              {
                "Name": "Alt-A: Subsea tie-back to Grane (4×6-slot templates)",
                "Rank": 1,
                "Rationale": "Highest NPV; leverages existing Grane infrastructure for lift gas and water handling. 23 wells + 2 multilateral; start-up heater and LP gas debottlenecking on Grane required. Provisions for future expansion with additional templates or subsea pump.",
                "RecommendedAction": "Approve"
              },
              {
                "Name": "Alt-B: Standalone FPSO",
                "Rank": 2,
                "Rationale": "Higher CAPEX and schedule risk per SRA and CRA. Provides independence from Grane but does not justify the cost premium given the reference-case volumes.",
                "RecommendedAction": "Reject"
              },
              {
                "Name": "Alt-C: Reduced scope — F-Structure only",
                "Rank": 3,
                "Rationale": "Lower initial investment but forgoes 55% of the reference STOIIP (D-Structure = 64.3 MSm³ REF). May be revisited if D-Structure volumes prove lower than P90 after DG3 appraisal.",
                "RecommendedAction": "Fallback"
              }
            ],
            "DevelopmentConcept": {
              "Summary": "Subsea development with 4×6-slot templates (24 slots), tie-back to Grane platform. Two flowlines (16\" and 14\") plus 8\" gas lift line. Distance to Grane ~10-12 km. Water depth 128–130 m.",
              "WellCount": 23,
              "MultilateralWells": 2,
              "TemplateSlots": 24,
