              },
              "Total": {
                "P90": 70.7,
                "REF": 118.7,
                "P10": 158.7
              }
            },
            "KeyUncertainties": [
              {
                "Factor": "Seismic time interpretation and depth conversion",
                "Impact": "High",
                "Description": "Top reservoir interpretation is uncertain due to limitations in seismic resolution. Depth conversion adds to total depth uncertainty of the top reservoir surface. New 4D baseline acquisition planned for 2020."
              },
              {
                "Factor": "Early water breakthrough",
                "Impact": "High",
                "Description": "Thin and heavy oil zone directly above an active aquifer. Recovery may be low due to high oil viscosity and thin oil column thickness. ICD/AICD and subsea pumps under evaluation."
              },
              {
                "Factor": "Injectite volume contribution",
                "Impact": "Medium",
                "Description": "Sand remobilisation and injection processes have generated a complex network of sand dykes and sills. Predicting their location and volumetric potential is highly uncertain. Mapped injectites contribute 22.1 MSm³ (REF) but unmapped injectites add 14.9 MSm³ with high uncertainty."
              },
              {
                "Factor": "Well placement optimisation",
                "Impact": "Medium",
                "Description": "Wells target areas with >10 m oil column in Heimdal and >12 m in mapped injectites. Higher placement towards top Heimdal and longer reservoir sections could improve recovery."
              }
            ],
            "UncertaintySummary": {
              "Basis": "PRMS; probabilistic FMU using 300 geo-realisations (3 selected: Real 1 = REF, Real 88 = P90, Real 58 = P10). Static in-place volumes from DG2 geomodels.",
              "Note": "Volumes from Table 11-23 of PM398-DD-200-001 Rev 01. Bo and GOR differentiated by structure.",
              "TotalRealisations": 300,
              "SelectedRealisations": {
                "P90": "Real 88",
                "REF": "Real 1",
                "P10": "Real 58"
              },
              "MethodologyReference": "FMU Level 2 static uncertainty workflow (GRAND DG2 geomodel)",
              "StaticInPlace_Oil_MSm3": {
                "P90": 70.7,
                "REF": 118.7,
                "P10": 158.7
              },
              "TargetSTOIIP_MSm3": {
                "P90": 57.4,
                "REF": 103.8,
                "P10": 142.6,
                "Note": "STOIIP by target thickness; excludes unmapped injectites (not well targets)"
              }
            },
            "DG3Recommendations": [
              "Adjust layer thickness below FWL in simulation grid to improve modelling of OWC movements",
              "Implement full Level 3 FMU uncertainty workflow for more detailed dynamic uncertainty analysis",
              "Investigate PERMZ value in unmapped injectites to better reflect sub-grid geology",
              "Run sensitivities on effect of periodical gas injection (huff & puff)",
              "Evaluate AICD vs ICD in lower completion",
              "Acquire new 4D seismic baseline in 2020 for monitoring",
              "Evaluate potential for infill drilling and subsea multiphase pumps"
