      "data": {
        "Name": "GRAND — Depth conversion & top reservoir uncertainty",
        "Summary": "Uncertainty in seismic time interpretation and depth conversion can reduce structural elevation, impacting volumes and NPV.",
        "Description": "Top reservoir interpretation is limited by seismic resolution; depth conversion adds uncertainty leading to large volumetric range and potential NPV downside.",
        "TypeID": "osdu:wks:reference-data--RiskType:risk:1.0.0",
        "EffectiveDateTime": "2019-04-26T00:00:00Z"
      }
    },
