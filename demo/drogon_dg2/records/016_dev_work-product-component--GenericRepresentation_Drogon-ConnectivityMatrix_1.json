      "CentralHorst ↔ WestLowland": {
        "fault": "F1",
        "transmissibility": 0.8,
        "seal_quality": "open",
        "grid_connections": 1420
      },
      "CentralHorst ↔ EastLowland": {
        "fault": "F2",
        "transmissibility": 0.15,
        "seal_quality": "baffle",
        "grid_connections": 980
      },
      "CentralNorth ↔ EastLowland": {
        "fault": "F3",
        "transmissibility": 0.1,
        "seal_quality": "baffle",
        "grid_connections": 650
      },
      "WestLowland ↔ CentralSouth": {
